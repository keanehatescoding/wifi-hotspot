#!/bin/sh
# NetworkManager dispatcher: keep the same-channel Wi-Fi hotspot in sync with
# the Wi-Fi client uplink.  Runs as root; started by NetworkManager directly.
#
# Read the user's configuration so a custom CLIENT= (or any other override in
# /etc/wifi-hotspot.conf) is honoured instead of silently defaulting to wlan0.
[ -r /etc/wifi-hotspot.conf ] && . /etc/wifi-hotspot.conf

# Default to wlan0 to stay consistent with wifi-hotspot's own default.  Do NOT
# guess the interface from $1: on a machine with several Wi-Fi adapters that
# would let an unrelated adapter's disconnect tear the hotspot down.  Users on
# a differently-named uplink (e.g. wlp2s0) must set CLIENT= in the config for
# automatic roaming to work.
CLIENT="${CLIENT:-wlan0}"

[ "$1" = "$CLIENT" ] || exit 0
case "$2" in
  up|dhcp4-change|connectivity-change) exec /usr/local/bin/wifi-hotspot sync ;;
  down)                              exec /usr/local/bin/wifi-hotspot down ;;
esac
exit 0
