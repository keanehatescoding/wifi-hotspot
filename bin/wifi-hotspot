#!/usr/bin/env bash
#
# wifi-hotspot - share the Wi-Fi *client* uplink as an access point (hotspot).
#
# Two ways to run the hotspot:
#
#   same  hostapd on a second virtual interface (ap0), pinned to the same
#         channel the client connection uses.  This is what single-radio cards
#         that only support same-channel STA+AP concurrency need (Realtek
#         RTL8852BE/rtw89 and most others), and it uses the radio at full speed.
#
#   p2p   a Wi-Fi Direct group owner, which on many cards may use a channel of
#         its own -- the radio hops between the two.  Used automatically when
#         the client's channel cannot host an AP (radar/DFS, "no IR", 6 GHz).
#         This is how Windows' Mobile Hotspot works.
#
# Usage: wifi-hotspot {up|down|restart|sync|status|detect}
#        wifi-hotspot up [--mode auto|same|p2p]
#
set -euo pipefail

# ---- defaults (override in /etc/wifi-hotspot.conf) -------------------------
CLIENT="wlan0"
AP="ap0"
SSID="${SSID:-}"
COUNTRY="${COUNTRY:-}"
AP_ADDR="10.42.0.1"
AP_PREFIX="24"
DHCP_RANGE="10.42.0.10,10.42.0.200,12h"
RUN_DIR="/run"
MODE="auto"                 # auto | same | p2p
P2P_BAND="bg"               # band for the Wi-Fi Direct group's own channel: bg | a
P2P_CHANNEL="auto"          # channel number for the group, or auto
WPA_CTRL_DIR="/run/wpa_supplicant"
SELF="$(readlink -f -- "$0")"
VERSION="0.2.5"
HW=g; CH=0; DFS=0
MANAGE_FIREWALL="${WIFI_HOTSPOT_MANAGE_FIREWALL:-1}" # set to 0 to leave the host firewall untouched
FIREWALL_BACKEND="${WIFI_HOTSPOT_FIREWALL_BACKEND:-auto}" # auto | raw | firewalld | ufw
NFT_TAG="wifi-hotspot"      # comment tag on the nftables rules we add
SECURITY="${WIFI_HOTSPOT_SECURITY:-wpa2}" # wpa2 | wpa3 | mixed (WPA2+WPA3 transition)
if [ "${WIFI_HOTSPOT_TEST_MODE:-}" = "1" ]; then
  CONF_PATH="${WIFI_HOTSPOT_CONF:-/etc/wifi-hotspot.conf}"
  CONF="${WIFI_HOTSPOT_CONF_HOSTAPD:-/etc/hostapd/${AP}.conf}"
  PSKFILE="${WIFI_HOTSPOT_PSKFILE:-/etc/hostapd/${AP}.psk}"
else
  CONF_PATH="/etc/wifi-hotspot.conf"
  CONF="/etc/hostapd/${AP}.conf"
  PSKFILE="/etc/hostapd/${AP}.psk"
fi
# shellcheck disable=SC1090
[ -r "$CONF_PATH" ] && . "$CONF_PATH"
DPID="${RUN_DIR}/dnsmasq-${AP}.pid"
HPID="${RUN_DIR}/hostapd-${AP}.pid"
STATE="${RUN_DIR}/wifi-hotspot-${AP}.state"
AP_IF="$AP"                 # interface serving the hotspot right now (runtime)
P2P_DEV="p2p-dev-${CLIENT}" # dedicated P2P device iface (not on every driver)
P2P_IFACE=""                # control iface that actually drives P2P
P2P_LAST=""                 # why the P2P probe failed
CAN_HOST=0; HAVE_DFS=0      # whether the client's channel can host an AP
CAP_APSTA=0; CAP_APSTA_CH=0; CAP_P2PGO=0; CAP_P2P_CH=0
MODE_CHOSEN=same; P2P_FREQ=0

log(){ printf '[wifi-hotspot] %s\n' "$*" >&2; }
die(){ log "ERROR: $*"; exit 1; }
# Validate enumerated settings, but only for commands that act on them,
# so that teardown/read-only commands (down, status, --version, ...) keep
# working even when the config contains a typo.
case "${1:-}" in up|restart|sync|qr)
  case "${SECURITY:-wpa2}" in wpa2|wpa3|mixed) ;; *) die "SECURITY must be one of: wpa2, wpa3, mixed (got '${SECURITY}')" ;; esac
  case "${FIREWALL_BACKEND:-auto}" in auto|raw|firewalld|ufw) ;; *) die "FIREWALL_BACKEND must be one of: auto, raw, firewalld, ufw (got '${FIREWALL_BACKEND}')" ;; esac
  ;;
esac
# Re-exec self as root.  pkexec first (no --disable-internal-agent so it can
# prompt on a terminal when no GUI polkit agent is registered), then sudo.
as_root(){
  [ "$(id -u)" -eq 0 ] && return 0
  local elev="${WIFI_HOTSPOT_ELEVATE:-}"
  if [ -z "$elev" ]; then
    if   command -v pkexec >/dev/null 2>&1; then elev=pkexec
    elif command -v sudo   >/dev/null 2>&1; then elev=sudo
    else die "root privileges required (install polkit/pkexec or sudo)"; fi
  fi
  exec "$elev" "$SELF" "$@"
}

# ---- reading the radio's capabilities --------------------------------------
# ``iw phy <phy> info`` is parsed for three things:
#   * which interface combinations exist (can an AP/go co-exist with a client?),
#   * which channels a network may be *started* on,
#   * what the client is tuned to right now.
client_phy(){ iw dev "$CLIENT" info 2>/dev/null | awk '/wiphy/{print "phy"$2; exit}'; }
iw_phy_info(){
  # Allow feeding a captured `iw phy info` sample (for testing/debugging)
  # via WIFI_HOTSPOT_IW_PHY_FILE, so the awk parsers can be exercised
  # without real hardware.
  if [ -n "${WIFI_HOTSPOT_IW_PHY_FILE:-}" ] && [ -r "$WIFI_HOTSPOT_IW_PHY_FILE" ]; then
    cat "$WIFI_HOTSPOT_IW_PHY_FILE"; return 0
  fi
  iw phy "$(client_phy)" info 2>/dev/null
}

# For each "valid interface combination": APSTA P2PGO CHANNELS TOTAL
# APSTA/P2PGO are 1 when that type can exist *together with* a client, per the
# group limits -- not merely because the type is listed somewhere.
_COMBOS_AWK='
function flush(   n, i, j, s, g, limit, types, t, arr, tot, ch, ok_ap, ok_go) {
  if (buf == "") return
  s = buf
  n = 0
  split("", gmemb)
  while (match(s, /#\{[^}]*\}[[:space:]]*<=[[:space:]]*[0-9]+/)) {
    g = substr(s, RSTART, RLENGTH)
    s = substr(s, RSTART + RLENGTH)
    types = g; sub(/^#\{/, "", types); sub(/\}.*$/, "", types)
    limit = g; sub(/.*<=/, "", limit); gsub(/[[:space:]]/, "", limit)
    n++
    gl[n] = limit + 0
    split(types, arr, ",")
    for (i in arr) {
      t = arr[i]; gsub(/^[[:space:]]+|[[:space:]]+$/, "", t)
      if (t != "") gmemb[n "," t] = 1
    }
  }
  if (n == 0) { buf = ""; return }
  tot = 1
  if (match(buf, /total[[:space:]]*<=[[:space:]]*[0-9]+/)) {
    t = substr(buf, RSTART, RLENGTH); sub(/.*<=/, "", t); gsub(/[[:space:]]/, "", t); tot = t + 0
  }
  ch = 1
  if (match(buf, /#channels[[:space:]]*<=[[:space:]]*[0-9]+/)) {
    t = substr(buf, RSTART, RLENGTH); sub(/.*<=/, "", t); gsub(/[[:space:]]/, "", t); ch = t + 0
  }
  ok_ap = (tot >= 2 && coexist("managed", "AP", n)) ? 1 : 0
  ok_go = (tot >= 2 && coexist("managed", "P2P-GO", n)) ? 1 : 0
  printf "%d %d %d %d\n", ok_ap, ok_go, ch, tot
  buf = ""
}
function coexist(a, b, n,   i, j) {
  for (i = 1; i <= n; i++) {
    if (!((i "," a) in gmemb)) continue
    for (j = 1; j <= n; j++) {
      if (!((j "," b) in gmemb)) continue
      if (i != j || gl[i] >= 2) return 1
    }
  }
  return 0
}
/valid interface combinations/ { incombo = 1; next }
incombo {
  s = $0; sub(/^[[:space:]]+/, "", s)
  if (s ~ /^\*[[:space:]]*#\{/) { flush(); buf = s; next }
  if (buf != "" && (s ~ /^(total|#)/ || buf ~ /,[[:space:]]*$/)) { buf = buf " " s; next }
  flush(); incombo = 0
}
END { if (incombo) flush() }
'
combos(){ iw_phy_info | awk "$_COMBOS_AWK"; }

# Channels a network may be started on, as ranges: BAND FIRST-LAST FLAG
_RANGES_AWK='
function band(f) { return (f < 2500) ? "bg" : ((f < 5925) ? "a" : "6g") }
function chnum(f) {
  if (band(f) == "bg") return (f == 2484) ? 14 : int((f - 2407) / 5)
  if (band(f) == "a")  return int((f - 5000) / 5)
  return int((f - 5950) / 5)
}
{
  if (!match($0, /^[[:space:]]*\*[[:space:]]*[0-9]+(\.[0-9]+)?[[:space:]]*MHz/)) next
  line = $0
  freq = substr(line, RSTART, RLENGTH)
  gsub(/[^0-9.]/, "", freq)
  rest = substr(line, RSTART + RLENGTH)
  if (rest ~ /disabled/ || rest ~ /no IR/) next
  flag = (rest ~ /radar detection/) ? "DFS" : "-"
  list[++n] = band(freq) " " chnum(freq) " " flag
}
END {
  for (i = 1; i <= n; i++) {
    split(list[i], p, " ")
    if (pband == "" || p[1] != pband || p[3] != pflag || (p[2] - plast) > 8) {
      if (pband != "") printf "%s %s-%s %s\n", pband, pfirst, plast, pflag
      pband = p[1]; pfirst = p[2]; plast = p[2]; pflag = p[3]
    } else {
      plast = p[2]
    }
  }
  if (pband != "") printf "%s %s-%s %s\n", pband, pfirst, plast, pflag
}
'

# Flags iw prints for a frequency, e.g. "(17.0 dBm) (radar detection)".
_FREQFLAGS_AWK='
match($0, /^[[:space:]]*\*[[:space:]]*[0-9]+(\.[0-9]+)?[[:space:]]*MHz/) {
  line = $0
  freq = substr(line, RSTART, RLENGTH); gsub(/[^0-9.]/, "", freq)
  if (freq + 0 != want + 0) next
  rest = substr(line, RSTART + RLENGTH)
  print rest
  exit
}
'
freq_flags(){ iw_phy_info | awk -v want="$1" "$_FREQFLAGS_AWK"; }

# Fill CAP_* from the interface combinations.
probe_caps(){
  local ap go ch _tot
  CAP_APSTA=0; CAP_APSTA_CH=0; CAP_P2PGO=0; CAP_P2P_CH=0
  while read -r ap go ch _tot; do
    if [ -z "${ap:-}" ]; then continue; fi
    if [ "$ap" = 1 ]; then
      CAP_APSTA=1
      if [ "${ch:-1}" -gt "$CAP_APSTA_CH" ]; then CAP_APSTA_CH=$ch; fi
    fi
    if [ "$go" = 1 ] && [ "${ch:-1}" -ge 2 ]; then
      CAP_P2PGO=1
      if [ "$ch" -gt "$CAP_P2P_CH" ]; then CAP_P2P_CH=$ch; fi
    fi
  done < <(combos || true)
}

# Can a network be started on this frequency?  Sets HAVE_DFS.  6 GHz never can.
can_host_freq(){
  HAVE_DFS=0
  local f="$1" flags
  [ "$f" -lt 5925 ] || return 1
  flags=$(freq_flags "$f")
  [ -n "$flags" ] || return 1
  case "$flags" in *disabled*|*"no IR"*) return 1 ;; esac
  case "$flags" in *"radar detection"*) HAVE_DFS=1 ;; esac
  return 0
}

# Human-readable reason why a frequency cannot host a network here.
host_reason(){
  local f="$1" flags
  [ "$f" -lt 5925 ] || { echo "6 GHz cannot host a hotspot"; return; }
  flags=$(freq_flags "$f")
  [ -n "$flags" ] || { echo "this card does not know the channel"; return; }
  case "$flags" in *disabled*) echo "the channel is disabled in the current regulatory domain"; return ;; esac
  case "$flags" in *"no IR"*)  echo "the channel is receive-only (no IR) here"; return ;; esac
  echo "the channel is not usable for an access point"
}

# ---- channel helpers -------------------------------------------------------
client_freq(){ iw dev "$CLIENT" link 2>/dev/null | awk '/freq:/{printf "%d\n", $2; exit}'; }
iface_chan(){ iw dev "$1" info 2>/dev/null | awk '/channel/{print $2; exit}'; }
iface_ssid(){ iw dev "$1" info 2>/dev/null | awk '/^[[:space:]]*ssid /{print $2; exit}'; }
go_ifaces(){ iw dev 2>/dev/null | awk '/^[ \t]*Interface /{n=$2} /^[ \t]*type /{if ($2=="P2P-GO") print n}'; }
is_running(){
  if [ -f "$HPID" ] && kill -0 "$(cat "$HPID")" 2>/dev/null; then return 0; fi
  pgrep -f "hostapd.*${CONF}" >/dev/null 2>&1
}

freq_chan(){
  local f="$1"
  if [ "$f" -lt 2500 ]; then
    if [ "$f" = 2484 ]; then echo 14; else echo $(( (f - 2407) / 5 )); fi
  elif [ "$f" -lt 5925 ]; then
    echo $(( (f - 5000) / 5 ))
  else
    echo $(( (f - 5950) / 5 ))
  fi
}
chan_label(){ printf '%s (%s MHz)' "$(freq_chan "$1")" "$1"; }
chan_band(){ # $1 = freq in MHz -> sets HW, CH and DFS
  local f="$1"
  DFS=0
  if [ "$f" -lt 2500 ]; then
    HW=g; CH=$(( (f - 2407) / 5 ))
    if [ "$f" = 2484 ]; then CH=14; fi
  elif [ "$f" -lt 5925 ]; then
    HW=a; CH=$(( (f - 5000) / 5 ))
    # DFS: derive from iw's own "radar detection" flag rather than a
    # hard-coded frequency list, so we never disagree with the kernel about
    # which channels need 802.11h (e.g. UNII-3 channels some cards mark DFS).
    case "$(freq_flags "$f")" in *"radar detection"*) DFS=1 ;; esac
  else
    HW=a; CH=$(( (f - 5950) / 5 ))
    if [ "$CH" -lt 1 ]; then CH=1; fi
  fi
}
host_ranges(){
  local band range flag b parts=() p out=""
  while read -r band range flag; do
    case "$band" in bg) b="2.4 GHz" ;; a) b="5 GHz" ;; 6g) b="6 GHz" ;; *) b="$band" ;; esac
    p="$b $range"
    if [ "$flag" = DFS ]; then p="$p (DFS)"; fi
    parts+=("$p")
  done < <(iw_phy_info | awk "$_RANGES_AWK")
  for p in "${parts[@]}"; do out="${out:+$out, }$p"; done
  printf '%s' "$out"
}

# ---- firewall --------------------------------------------------------------
# Hosts commonly ship an nftables ruleset with `policy drop` on INPUT/forward
# (e.g. Arch's /etc/nftables.conf).  iptables rules alone cannot punch through
# that: a packet must be accepted by *every* base chain on the hook, so we add
# a scoped accept rule for the AP interface into the existing `ip filter`
# chains and remove it again on `down`.
nft_ok(){ command -v nft >/dev/null 2>&1 && nft list table ip filter >/dev/null 2>&1; }
nft_rule_add(){ # $1 = chain, $2 = iifname|oifname, $3 = interface
  local ch="$1" dir="$2" dev="$3"
  nft list chain ip filter "$ch" >/dev/null 2>&1 || return 0
  if nft -a list chain ip filter "$ch" 2>/dev/null | grep -q "$dir \"$dev\" accept comment \"$NFT_TAG\""; then
    return 0
  fi
  nft insert rule ip filter "$ch" "$dir" "$dev" accept comment "\"$NFT_TAG\"" 2>/dev/null || true
}
nft_rules_del(){
  command -v nft >/dev/null 2>&1 || return 0
  local ch h
  for ch in INPUT OUTPUT FORWARD forward input output; do
    nft list chain ip filter "$ch" >/dev/null 2>&1 || continue
    nft -a list chain ip filter "$ch" 2>/dev/null \
      | awk -v t="$NFT_TAG" 'index($0,t){for(i=1;i<=NF;i++) if($i=="handle"){print $(i+1); break}}' \
      | while read -r h; do nft delete rule ip filter "$ch" handle "$h" 2>/dev/null || true; done
  done
}
firewall_backend(){
  # Allow an explicit override from config.
  case "${FIREWALL_BACKEND:-auto}" in
    raw|firewalld|ufw) echo "${FIREWALL_BACKEND}"; return ;;
  esac
  # Auto-detect: prefer native front-ends when they are active.
  if command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active --quiet firewalld 2>/dev/null; then
    echo firewalld; return
  fi
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active'; then
    echo ufw; return
  fi
  echo raw
}

ensure_fw_raw(){
  # iptables: plain-iptables hosts and the iptables-nft compat chains.
  # Rules are tagged with $NFT_TAG so remove_fw only deletes what we added
  # (pre-existing rules with the same spec are left untouched). NAT is
  # restricted to the AP subnet so we do not masquerade unrelated traffic.
  if command -v iptables >/dev/null 2>&1; then
    iptables -t nat -C POSTROUTING -s "$AP_ADDR/$AP_PREFIX" -o "$CLIENT" -m comment --comment "$NFT_TAG" -j MASQUERADE 2>/dev/null || \
      iptables -t nat -A POSTROUTING -s "$AP_ADDR/$AP_PREFIX" -o "$CLIENT" -m comment --comment "$NFT_TAG" -j MASQUERADE
    iptables -C FORWARD -i "$AP_IF" -o "$CLIENT" -m comment --comment "$NFT_TAG" -j ACCEPT 2>/dev/null || \
      iptables -A FORWARD -i "$AP_IF" -o "$CLIENT" -m comment --comment "$NFT_TAG" -j ACCEPT
    iptables -C FORWARD -i "$CLIENT" -o "$AP_IF" -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "$NFT_TAG" -j ACCEPT 2>/dev/null || \
      iptables -A FORWARD -i "$CLIENT" -o "$AP_IF" -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "$NFT_TAG" -j ACCEPT
  fi
  # nftables: also accept AP traffic in the native base chains.
  if nft_ok; then
    nft_rule_add INPUT   iifname "$AP_IF"
    nft_rule_add forward iifname "$AP_IF"
    nft_rule_add forward oifname "$AP_IF"
    nft_rule_add FORWARD iifname "$AP_IF"
    nft_rule_add FORWARD oifname "$AP_IF"
  fi
}

ensure_fw_firewalld(){
  # Use firewalld's own CLI so we do not fight it for ruleset ownership.
  # Only scoped direct rules: do not toggle zone-wide masquerade, which would
  # affect traffic unrelated to the hotspot (and --remove-masquerade on down
  # would turn off a pre-existing setting).
  firewall-cmd --direct --add-rule ipv4 nat POSTROUTING 0 -s "$AP_ADDR/$AP_PREFIX" -o "$CLIENT" -j MASQUERADE >/dev/null 2>&1 || true
  firewall-cmd --direct --add-rule ipv4 filter FORWARD 0 -i "$AP_IF" -o "$CLIENT" -j ACCEPT >/dev/null 2>&1 || true
  firewall-cmd --direct --add-rule ipv4 filter FORWARD 0 -i "$CLIENT" -o "$AP_IF" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT >/dev/null 2>&1 || true
  firewall-cmd --direct --add-rule ipv4 filter INPUT 0 -i "$AP_IF" -j ACCEPT >/dev/null 2>&1 || true
}

ensure_fw_ufw(){
  # ufw has no runtime NAT; add the tagged iptables NAT/forward rules so
  # internet sharing keeps working (same as the raw backend).
  ufw allow in on "$AP_IF" >/dev/null 2>&1 || true
  ufw route allow in on "$AP_IF" out on "$CLIENT" >/dev/null 2>&1 || true
  if command -v iptables >/dev/null 2>&1; then
    iptables -t nat -C POSTROUTING -s "$AP_ADDR/$AP_PREFIX" -o "$CLIENT" -m comment --comment "$NFT_TAG" -j MASQUERADE 2>/dev/null || \
      iptables -t nat -A POSTROUTING -s "$AP_ADDR/$AP_PREFIX" -o "$CLIENT" -m comment --comment "$NFT_TAG" -j MASQUERADE
    iptables -C FORWARD -i "$AP_IF" -o "$CLIENT" -m comment --comment "$NFT_TAG" -j ACCEPT 2>/dev/null || \
      iptables -A FORWARD -i "$AP_IF" -o "$CLIENT" -m comment --comment "$NFT_TAG" -j ACCEPT
    iptables -C FORWARD -i "$CLIENT" -o "$AP_IF" -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "$NFT_TAG" -j ACCEPT 2>/dev/null || \
      iptables -A FORWARD -i "$CLIENT" -o "$AP_IF" -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "$NFT_TAG" -j ACCEPT
  fi
  log "ufw: also add a MASQUERADE rule to /etc/ufw/before.rules for persistence, or set MANAGE_FIREWALL=0"
}

ensure_fw(){
  [ "$MANAGE_FIREWALL" = 1 ] || return 0
  # Remember the pre-existing ip_forward setting so `down` can restore it.
  if command -v sysctl >/dev/null 2>&1; then
    [ -f /run/wifi-hotspot-ip_forward ] || sysctl -n net.ipv4.ip_forward > /run/wifi-hotspot-ip_forward 2>/dev/null || true
    sysctl -qw net.ipv4.ip_forward=1 || true
  fi
  local backend; backend=$(firewall_backend)
  printf '%s' "$backend" > /run/wifi-hotspot-fw-backend 2>/dev/null || true
  log "firewall backend: $backend"
  case "$backend" in
    firewalld) ensure_fw_firewalld ;;
    ufw)       ensure_fw_ufw ;;
    *)         ensure_fw_raw ;;
  esac
}
remove_fw_raw(){
  if command -v iptables >/dev/null 2>&1; then
    iptables -t nat -D POSTROUTING -s "$AP_ADDR/$AP_PREFIX" -o "$CLIENT" -m comment --comment "$NFT_TAG" -j MASQUERADE 2>/dev/null || true
    iptables -D FORWARD -i "$AP_IF" -o "$CLIENT" -m comment --comment "$NFT_TAG" -j ACCEPT 2>/dev/null || true
    iptables -D FORWARD -i "$CLIENT" -o "$AP_IF" -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "$NFT_TAG" -j ACCEPT 2>/dev/null || true
  fi
  nft_rules_del
}

remove_fw_firewalld(){
  firewall-cmd --direct --remove-rule ipv4 nat POSTROUTING 0 -s "$AP_ADDR/$AP_PREFIX" -o "$CLIENT" -j MASQUERADE >/dev/null 2>&1 || true
  firewall-cmd --direct --remove-rule ipv4 filter FORWARD 0 -i "$AP_IF" -o "$CLIENT" -j ACCEPT >/dev/null 2>&1 || true
  firewall-cmd --direct --remove-rule ipv4 filter FORWARD 0 -i "$CLIENT" -o "$AP_IF" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT >/dev/null 2>&1 || true
  firewall-cmd --direct --remove-rule ipv4 filter INPUT 0 -i "$AP_IF" -j ACCEPT >/dev/null 2>&1 || true
}

remove_fw_ufw(){
  ufw delete allow in on "$AP_IF" >/dev/null 2>&1 || true
  ufw route delete allow in on "$AP_IF" out on "$CLIENT" >/dev/null 2>&1 || true
  if command -v iptables >/dev/null 2>&1; then
    iptables -t nat -D POSTROUTING -s "$AP_ADDR/$AP_PREFIX" -o "$CLIENT" -m comment --comment "$NFT_TAG" -j MASQUERADE 2>/dev/null || true
    iptables -D FORWARD -i "$AP_IF" -o "$CLIENT" -m comment --comment "$NFT_TAG" -j ACCEPT 2>/dev/null || true
    iptables -D FORWARD -i "$CLIENT" -o "$AP_IF" -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "$NFT_TAG" -j ACCEPT 2>/dev/null || true
  fi
}

remove_fw(){
  # Restore ip_forward to whatever it was before `up`.
  if [ -f /run/wifi-hotspot-ip_forward ]; then
    sysctl -qw "net.ipv4.ip_forward=$(cat /run/wifi-hotspot-ip_forward)" 2>/dev/null || true
    rm -f /run/wifi-hotspot-ip_forward
  fi
  local backend; backend=$(cat /run/wifi-hotspot-fw-backend 2>/dev/null || firewall_backend)
  rm -f /run/wifi-hotspot-fw-backend
  case "$backend" in
    firewalld) remove_fw_firewalld ;;
    ufw)       remove_fw_ufw ;;
    *)         remove_fw_raw ;;
  esac
}

# ---- state -----------------------------------------------------------------
save_state(){ { for kv in "$@"; do printf '%s\n' "$kv"; done; } > "$STATE"; chmod 600 "$STATE" 2>/dev/null || true; }
state_get(){ [ -r "$STATE" ] || return 1; awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,"");print;exit}' "$STATE"; }

# ---- passphrase ------------------------------------------------------------
gen_mac(){ # locally-administered MAC derived from CLIENT's MAC
  local m o1 o2 o3 o4 o5 o6
  m=$(cat "/sys/class/net/${CLIENT}/address")
  IFS=':' read -r o1 o2 o3 o4 o5 o6 <<<"$m"
  printf '%02x:%s:%s:%s:%s:%02x' \
    $(( 0x$o1 | 0x02 )) "$o2" "$o3" "$o4" "$o5" $(( (0x$o6 + 1) & 0xff ))
}
get_psk(){
  [ -s "$PSKFILE" ] && { cat "$PSKFILE"; return; }
  local p=""
  p=$(nmcli -s -g 802-11-wireless-security.psk connection show "$SSID" 2>/dev/null || true)
  [ -n "$p" ] || p=$(nmcli -s -g 802-11-wireless-security.psk connection show Hotspot 2>/dev/null || true)
  [ -n "$p" ] || p=$(head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | cut -c1-12)
  install -m 600 /dev/null "$PSKFILE"
  printf '%s' "$p" >"$PSKFILE"
  printf '%s' "$p"
}
hex_of(){ printf '%s' "$1" | od -An -tx1 | tr -d ' \n'; }

# ---- hostapd mode (same channel) -------------------------------------------
write_conf(){
  local psk; psk=$(get_psk)
  {
    printf 'interface=%s\n'      "$AP"
    printf 'driver=nl80211\n'
    printf 'ssid=%s\n'           "$SSID"
    printf 'hw_mode=%s\n'        "$HW"
    printf 'channel=%s\n'        "$CH"
    printf 'ieee80211n=1\n'
    printf 'wmm_enabled=1\n'
    printf 'country_code=%s\n'   "$COUNTRY"
    printf 'auth_algs=1\n'
    printf 'ignore_broadcast_ssid=0\n'
    printf 'wpa=2\n'
    case "${SECURITY:-wpa2}" in
      wpa3)
        printf 'wpa_key_mgmt=SAE\n'
        printf 'rsn_pairwise=CCMP\n'
        printf 'ieee80211w=2\n'          # PMF required for WPA3
        printf 'sae_password=%s\n' "$psk"
        ;;
      mixed)
        printf 'wpa_passphrase=%s\n' "$psk"
        printf 'wpa_key_mgmt=WPA-PSK SAE\n'
        printf 'rsn_pairwise=CCMP\n'
        printf 'ieee80211w=1\n'          # PMF optional (transition mode)
        printf 'sae_password=%s\n' "$psk"
        ;;
      *)  # wpa2 (default)
        printf 'wpa_passphrase=%s\n' "$psk"
        printf 'wpa_key_mgmt=WPA-PSK\n'
        printf 'rsn_pairwise=CCMP\n'
        ;;
    esac
    if [ "$HW" = a ]; then
      printf 'ieee80211ac=1\n'
      # 802.11h (DFS radar detection + TPC) is only needed on DFS channels
      # and hostapd refuses to enable it without 802.11d, so emitting it
      # unconditionally breaks non-DFS 5 GHz channels (e.g. ch 36).
      if [ "$DFS" -eq 1 ]; then
        printf 'ieee80211d=1\n'
        printf 'ieee80211h=1\n'
      fi
    fi
  } >"$CONF"
  chmod 600 "$CONF"
}

ensure_net(){
  ip addr replace "${AP_ADDR}/${AP_PREFIX}" dev "$AP_IF"
  ensure_fw
  if [ -f "$DPID" ] && kill -0 "$(cat "$DPID")" 2>/dev/null; then
    :
  else
    dnsmasq --interface="$AP_IF" --except-interface=lo --bind-interfaces \
      --dhcp-range="$DHCP_RANGE" \
      --dhcp-option=3,"$AP_ADDR" --dhcp-option=6,"$AP_ADDR" \
      --dhcp-authoritative \
      --dhcp-leasefile="${RUN_DIR}/dnsmasq-${AP}.leases" \
      --pid-file="$DPID" --conf-file=/dev/null 9>&-
  fi
}

stop_services(){
  if [ -f "$HPID" ] && kill -0 "$(cat "$HPID")" 2>/dev/null; then
    kill "$(cat "$HPID")" 2>/dev/null || true
  fi
  pkill -f "hostapd.*${CONF}" 2>/dev/null || true
  rm -f "$HPID" 2>/dev/null || true
  if [ -f "$DPID" ] && kill -0 "$(cat "$DPID")" 2>/dev/null; then
    kill "$(cat "$DPID")" 2>/dev/null || true
  fi
  rm -f "$DPID" 2>/dev/null || true
  remove_fw
}

up_same(){
  command -v hostapd >/dev/null || die "hostapd is not installed"
  AP_IF="$AP"
  if is_running && [ "$(iface_chan "$AP" || true)" = "$CH" ]; then
    log "hotspot already running on channel ${CH}"
    save_state "MODE=same" "AP_IF=$AP"
    ensure_net
    return 0
  fi
  remove_existing
  AP_IF="$AP"
  if [ ! -e "/sys/class/net/${AP}" ]; then
    iw phy "$(client_phy)" interface add "$AP" type __ap
  fi
  nmcli device set "$AP" managed no >/dev/null 2>&1 || true
  ip link set dev "$AP" down 2>/dev/null || true
  iw dev "$AP" set type __ap 2>/dev/null || true
  ip link set dev "$AP" address "$(gen_mac)"   # avoids ENOTUNIQ (duplicate MAC)
  ip link set dev "$AP" up

  write_conf
  hostapd -B -P "$HPID" "$CONF" 9>&-
  sleep 1
  is_running || die "hostapd failed to start (check: journalctl -u wifi-hotspot)"
  save_state "MODE=same" "AP_IF=$AP"
  ensure_net
  log "hotspot '${SSID}' up on ${AP} (ch${CH}); clients get ${AP_ADDR}/24 via NAT over ${CLIENT}"
}

# ---- Wi-Fi Direct (P2P-GO) mode --------------------------------------------
# The group is started by the wpa_supplicant NetworkManager already runs, which
# creates a ``p2p-<client>-N`` interface of type P2P-GO that can sit on a
# channel of its own.  We only add addressing, DHCP and NAT to it.
#
# wpa_supplicant drives P2P in one of two layouts:
#   * on a dedicated P2P-device interface ``p2p-dev-<client>``, which the
#     driver creates when it lists P2P-device under "Supported interface
#     modes" (iwlwifi does), or
#   * directly on the client interface itself when it does not (rtw89 does
#     not; wpa_supplicant then never makes a p2p-dev socket).
# Both work; only the control socket's name differs, so we probe for it.
# ``STATUS`` reports p2p_device_address only while P2P is really running,
# which makes it a safe, read-only test.
p2p_iface_state(){ # $1 = wpa_supplicant control interface
  local out
  out=$(wpa_cli -p "$WPA_CTRL_DIR" -i "$1" status 2>&1 || true)
  case "$out" in
    *p2p_device_address=*)   echo ok ;;
    *"Permission denied"*)   echo noperm ;;  # can't read the dir, so can't tell
    *"No such file"*|*"No such device"*|*"Failed to connect"*|*"Connection refused"*)
                             echo no-sock ;;
    *)                       echo no-p2p ;;  # socket answers, P2P is not running
  esac
}
# Pick the control interface that drives P2P and remember it in P2P_IFACE.
# On failure P2P_LAST holds the most useful reason.
p2p_set_iface(){
  local cand st seen=""
  for cand in "$P2P_DEV" "$CLIENT"; do
    st=$(p2p_iface_state "$cand")
    case "$st" in
      ok)      P2P_IFACE="$cand"; return 0 ;;
      noperm)  seen=noperm ;;
      no-sock) [ -n "$seen" ] || seen=no-sock ;;
      *)       [ -n "$seen" ] || seen=no-p2p ;;
    esac
  done
  P2P_LAST="${seen:-unknown}"
  return 1
}
# Whether Wi-Fi Direct can be used, and if not, why.  Echoes one code:
#   ok | no-wpa-cli | no-cap | no-p2p | no-sock | noperm | unknown
# This is for yes/no decisions.  Because it is always used as $(p2p_status),
# it runs in a subshell and cannot hand back P2P_IFACE; code that needs the
# control interface must call p2p_set_iface itself.
p2p_status(){
  command -v wpa_cli >/dev/null 2>&1 || { echo no-wpa-cli; return; }
  [ "$CAP_P2PGO" = 1 ] || { echo no-cap; return; }
  if p2p_set_iface; then echo ok; else echo "$P2P_LAST"; fi
}
p2p_reason(){ # human text for a p2p_status code
  case "$1" in
    no-wpa-cli) echo "wpa_cli is not installed" ;;
    no-cap)     echo "the driver cannot put a group owner on a channel of its own" ;;
    no-p2p)     echo "wpa_supplicant is not running P2P" ;;
    no-sock)    echo "no wpa_supplicant control socket in ${WPA_CTRL_DIR}" ;;
    noperm)     echo "cannot read ${WPA_CTRL_DIR} (needs root)" ;;
    *)          echo "Wi-Fi Direct is not available" ;;
  esac
}
p2p_ready(){ [ "$(p2p_status)" = ok ]; }
wpa_out(){ wpa_cli -p "$WPA_CTRL_DIR" -i "${P2P_IFACE:-$P2P_DEV}" "$@" 2>&1 || true; }
wpa_ok(){ [ "$(wpa_out "$@" | tr -d '\r\n')" = OK ]; }
wpa_set(){ # $1 = network id, $2 = passphrase
  local id="$1" psk="$2"
  wpa_ok set_network "$id" ssid "$(hex_of "$SSID")"   || return 1
  # NB: the passphrase is an argument to wpa_cli, so it is briefly visible in
  # the process list; there is no way to hand it to wpa_cli otherwise.
  wpa_ok set_network "$id" psk "\"$psk\""             || return 1
  wpa_ok set_network "$id" key_mgmt WPA-PSK           || return 1
  wpa_ok set_network "$id" proto RSN                  || return 1
  wpa_ok set_network "$id" pairwise CCMP              || return 1
  wpa_ok set_network "$id" mode 3                     || return 1
  wpa_ok set_network "$id" disabled 2                 || return 1
}
p2p_remove_new(){ # $1 = space-separated interface names that existed before
  local before=" $1 " g
  for g in $(go_ifaces); do
    case "$before" in *" $g "*) continue ;; esac
    wpa_out p2p_group_remove "$g" >/dev/null 2>&1 || true
  done
}
p2p_forget(){ # $1 = network id; also drops wpa_supplicant's persistent copy
  local id="${1:-}" got hex
  [ -n "$id" ] || return 0
  wpa_out remove_network "$id" >/dev/null 2>&1 || true
  hex=$(hex_of "$SSID")
  wpa_out list_networks 2>/dev/null | awk -F'\t' \
      'NR>1 && $1 ~ /^[0-9]+$/ && $4 ~ /P2P-PERSISTENT/ {print $1}' \
    | while read -r id; do
        got=$(wpa_out get_network "$id" ssid 2>/dev/null | tr -d '"' | tr '[:upper:]' '[:lower:]' || true)
        if [ "$got" = "$(printf '%s' "$SSID" | tr '[:upper:]' '[:lower:]')" ] || [ "$got" = "$hex" ]; then
          wpa_out remove_network "$id" >/dev/null 2>&1 || true
        fi
      done
}
p2p_freq(){ # own-channel frequency for the group, in MHz
  local f=""
  case "$P2P_BAND" in
    bg) f=2437 ;;
    a)  f=5180 ;;
    *)  die "P2P_BAND must be bg or a (got '$P2P_BAND')" ;;
  esac
  if [ "$P2P_CHANNEL" != auto ] && [ -n "$P2P_CHANNEL" ]; then
    case "$P2P_BAND" in
      bg) if [ "$P2P_CHANNEL" -ge 1 ] 2>/dev/null && [ "$P2P_CHANNEL" -le 14 ]; then
            if [ "$P2P_CHANNEL" = 14 ]; then f=2484; else f=$(( 2407 + 5 * P2P_CHANNEL )); fi
          else
            log "warn: P2P_CHANNEL=$P2P_CHANNEL is not a 2.4 GHz channel; using $(chan_label "$f")"
          fi ;;
      a)  if [ "$P2P_CHANNEL" -ge 32 ] 2>/dev/null && [ "$P2P_CHANNEL" -le 177 ]; then
            f=$(( 5000 + 5 * P2P_CHANNEL ))
          else
            log "warn: P2P_CHANNEL=$P2P_CHANNEL is not a 5 GHz channel; using $(chan_label "$f")"
          fi ;;
    esac
  fi
  if ! can_host_freq "$f"; then
    log "warn: $(chan_label "$f") cannot host a network on this card; falling back"
    case "$P2P_BAND" in bg) f=2437 ;; a) f=5180 ;; esac
    can_host_freq "$f" || die "no usable channel for the Wi-Fi Direct group on band '$P2P_BAND'"
  fi
  printf '%s' "$f"
}

wait_go_iface(){ # $1 = space-separated interface names that existed before
  local before=" $1 " name _
  for _ in $(seq 1 30); do
    for name in $(go_ifaces); do
      case "$before" in *" $name "*) continue ;; esac
      if [ -n "$(iface_ssid "$name")" ]; then printf '%s' "$name"; return 0; fi
    done
    sleep 0.5
  done
  return 1
}

up_p2p(){
  case "${SECURITY:-wpa2}" in
    wpa3)  die "Wi-Fi Direct mode does not support WPA3; use MODE=same, or set SECURITY=mixed/wpa2" ;;
    mixed) log "WARNING: Wi-Fi Direct mode supports WPA2 only; running WPA2 despite SECURITY=mixed" ;;
  esac
  command -v dnsmasq >/dev/null || die "dnsmasq is not installed"
  # p2p_set_iface must run here, in this shell, to set P2P_IFACE: $(p2p_status)
  # would probe inside a subshell and lose the result.
  command -v wpa_cli >/dev/null 2>&1 || die "cannot use Wi-Fi Direct: $(p2p_reason no-wpa-cli)"
  [ "$CAP_P2PGO" = 1 ] || die "cannot use Wi-Fi Direct: $(p2p_reason no-cap)"
  p2p_set_iface || die "cannot use Wi-Fi Direct: $(p2p_reason "$P2P_LAST")"
  local curmode; curmode=$(state_get MODE || true)
  if [ "${curmode:-}" = p2p ]; then
    AP_IF=$(state_get AP_IF || true)
    if [ -n "${AP_IF:-}" ] && [ -e "/sys/class/net/${AP_IF}" ]; then
      log "Wi-Fi Direct hotspot already running on ${AP_IF}"
      ensure_net
      return 0
    fi
  fi
  remove_existing

  chan_band "$P2P_FREQ"
  log "starting Wi-Fi Direct group on $(chan_label "$P2P_FREQ") via ${P2P_IFACE}"
  local before net go psk
  before=$(go_ifaces | tr '\n' ' ')
  net=$(wpa_out add_network | tr -d '\r\n')
  case "$net" in ''|*[!0-9]*) die "wpa_supplicant refused to add a network (reply: ${net:-none})" ;; esac
  psk=$(get_psk)
  if ! wpa_set "$net" "$psk"; then
    p2p_forget "$net"
    die "wpa_supplicant refused the hotspot settings"
  fi
  if ! wpa_ok p2p_group_add persistent="$net" freq="$P2P_FREQ"; then
    p2p_forget "$net"
    die "wpa_supplicant could not start the group on $(chan_label "$P2P_FREQ")"
  fi
  go=$(wait_go_iface "$before" || true)
  if [ -z "${go:-}" ]; then
    p2p_remove_new "$before"
    p2p_forget "$net"
    die "wpa_supplicant created no group interface; this card/driver may not allow a group owner next to a client"
  fi
  AP_IF="$go"
  nmcli device set "$AP_IF" managed no >/dev/null 2>&1 || true
  ip link set dev "$AP_IF" up 2>/dev/null || true
  save_state "MODE=p2p" "AP_IF=$AP_IF" "P2P_NET=$net" "P2P_FREQ=$P2P_FREQ" "P2P_CTRL=$P2P_IFACE"
  ensure_net
  log "hotspot '${SSID}' up as a Wi-Fi Direct group on ${AP_IF} ($(chan_label "$P2P_FREQ")); clients get ${AP_ADDR}/24 via NAT over ${CLIENT}"
}

# ---- mode selection --------------------------------------------------------
choose_mode(){
  case "$MODE" in
    same) MODE_CHOSEN=same ;;
    p2p)  MODE_CHOSEN=p2p ;;
    auto)
      if [ "${SECURITY:-wpa2}" = "wpa3" ]; then
        MODE_CHOSEN=same                 # WPA3 is not supported in p2p mode
      elif [ "$CAN_HOST" = 1 ] && [ "$HAVE_DFS" = 0 ]; then
        MODE_CHOSEN=same                 # the client's channel can host an AP
      elif [ "$CAP_P2PGO" = 1 ] && p2p_ready; then
        MODE_CHOSEN=p2p                  # it can't; give the group a channel of its own
      else
        MODE_CHOSEN=same                 # DFS (works, just slow) or an error in up_same
      fi ;;
    *) die "MODE must be auto, same or p2p (got '$MODE')" ;;
  esac
  if [ "$MODE_CHOSEN" = p2p ]; then P2P_FREQ=$(p2p_freq); fi
}

# ---- stopping --------------------------------------------------------------
remove_existing(){
  local mode apif net ctrl
  mode=$(state_get MODE || true); apif=$(state_get AP_IF || true)
  net=$(state_get P2P_NET || true); ctrl=$(state_get P2P_CTRL || true)
  AP_IF="${apif:-$AP}"
  stop_services
  if [ "${mode:-same}" = p2p ]; then
    # Find the control interface again if we have no record of it.
    P2P_IFACE="${ctrl:-}"
    if [ -z "$P2P_IFACE" ] || [ "$(p2p_iface_state "$P2P_IFACE")" != ok ]; then
      p2p_set_iface || P2P_IFACE="$P2P_DEV"
    fi
    local g ss
    for g in $(go_ifaces); do
      ss=$(iface_ssid "$g" || true)
      if [ "$g" = "${apif:-}" ] || [ "$ss" = "$SSID" ]; then
        wpa_out p2p_group_remove "$g" >/dev/null 2>&1 || true
      fi
    done
    p2p_forget "${net:-}"
  fi
  if [ -e "/sys/class/net/${AP_IF}" ]; then
    ip link set "$AP_IF" down 2>/dev/null || true
    iw dev "$AP_IF" del 2>/dev/null || true
  fi
  rm -f "$STATE"
}

# ---- commands --------------------------------------------------------------
# ---- config validation -----------------------------------------------------
require_ssid(){ [ -n "${SSID:-}" ] || die "SSID is not set; set SSID in /etc/wifi-hotspot.conf (e.g. SSID=\"MyHotspot\")"; }
require_country(){ [ -n "${COUNTRY:-}" ] || die "COUNTRY is not set; set COUNTRY in /etc/wifi-hotspot.conf (ISO 3166-1 alpha-2, e.g. US, GB, DE) - a wrong code is a regulatory/compliance problem"; }

# ---- locking ---------------------------------------------------------------
# Serialize mutating operations (up/down/sync) across the dispatcher, the
# systemd unit and manual invocations.
lock_acquire(){
  [ -n "${WIFI_HOTSPOT_NOLOCK:-}" ] && return 0
  command -v flock >/dev/null 2>&1 || return 0
  exec 9>/run/wifi-hotspot.lock
  if ! flock -w 10 9; then
    echo "wifi-hotspot: another operation is in progress (lock timeout)" >&2
    exit 1
  fi
}

cmd_up(){
  require_ssid
  require_country
  local freq
  freq=$(client_freq || true)
  [ -n "${freq:-}" ] || die "client '${CLIENT}' is not connected to Wi-Fi; AP channel unknown"
  # Refuse to reuse the uplink's subnet for the AP (would break routing).
  # NOTE: heuristic compares the first three octets (/24); accurate for the
  # common case. Use ipcalc for unusual prefixes.
  local cnet anet
  cnet=$(ip -4 addr show dev "$CLIENT" 2>/dev/null | awk '/inet /{print $2; exit}')
  anet="${AP_ADDR}/${AP_PREFIX}"
  if [ -n "$cnet" ]; then
    local cn an
    cn=$(printf '%s' "${cnet%/*}" | cut -d. -f1-3)
    an=$(printf '%s' "${AP_ADDR}" | cut -d. -f1-3)
    if [ "$cn" = "$an" ]; then
      die "AP subnet ($anet) overlaps the uplink subnet ($cnet); change AP_ADDR/AP_PREFIX in /etc/wifi-hotspot.conf"
    fi
  fi
  chan_band "$freq"
  if can_host_freq "$freq"; then CAN_HOST=1; else CAN_HOST=0; fi
  probe_caps
  [ "$CAP_APSTA" = 1 ] || die "this card's driver cannot run an access point alongside a client connection"
  choose_mode
  log "uplink $(chan_label "$freq") -> ${MODE_CHOSEN} mode"
  if [ "$MODE_CHOSEN" = p2p ]; then
    up_p2p
  elif [ "$CAN_HOST" != 1 ]; then
    # Refuse up front with a clear reason instead of letting hostapd fail.
    if p2p_ready; then
      if [ "${SECURITY:-wpa2}" = "wpa3" ]; then
        die "cannot share this connection: $(chan_label "$freq") cannot host an access point ($(host_reason "$freq")); connect on a channel that can host an AP, or set SECURITY=mixed or wpa2"
      fi
      die "cannot share this connection: $(chan_label "$freq") cannot host an access point ($(host_reason "$freq")); use --mode p2p or MODE=auto"
    fi
    die "cannot share this connection: $(chan_label "$freq") cannot host an access point ($(host_reason "$freq")) and Wi-Fi Direct is unavailable ($(p2p_reason "$(p2p_status)"))"
  else
    up_same
  fi
}

cmd_down(){
  local mode apif
  mode=$(state_get MODE || true); apif=$(state_get AP_IF || true)
  AP_IF="${apif:-$AP}"
  if [ -n "${mode:-}" ]; then
    log "stopping hotspot (${mode} mode on ${AP_IF})"
  else
    log "no state file; cleaning up ${AP_IF} and any leftover Wi-Fi Direct group"
  fi
  remove_existing
}

cmd_sync(){
  local mode apif freq have
  mode=$(state_get MODE || true)
  if [ "$mode" = p2p ]; then
    apif=$(state_get AP_IF || true)
    if [ -n "${apif:-}" ] && [ -e "/sys/class/net/${apif}" ]; then
      AP_IF="$apif"; ensure_net       # the group keeps its own channel; nothing to follow
      return 0
    fi
    log "sync: Wi-Fi Direct group is gone; starting the hotspot again"
    cmd_up
    return 0
  fi
  freq=$(client_freq || true)
  if [ -z "${freq:-}" ]; then
    log "client '${CLIENT}' not connected; leaving hotspot as-is"
    return 0
  fi
  chan_band "$freq"
  have=$(iface_chan "$AP" || true)
  if ! is_running || [ "$have" != "$CH" ]; then
    log "sync: hotspot channel ${have:-none} -> ${CH}"
    cmd_down
    cmd_up
  fi
}

cmd_status(){
  local mode apif g ss
  mode=$(state_get MODE || true); apif=$(state_get AP_IF || true)
  if [ -z "${mode:-}" ]; then
    # No state file (e.g. started by an older version): infer from what runs.
    if is_running; then
      mode=same; apif="$AP"
    else
      for g in $(go_ifaces); do
        ss=$(iface_ssid "$g" || true)
        if [ "$ss" = "$SSID" ]; then mode=p2p; apif="$g"; break; fi
      done
    fi
  fi
  [ -n "${apif:-}" ] || apif="$AP"
  printf 'client %-6s: ' "$CLIENT"; iw dev "$CLIENT" link 2>/dev/null | awk '/SSID|freq/{printf "%s ",$0} END{print ""}' || true
  printf 'mode         : '; if [ -n "${mode:-}" ]; then echo "${mode} (${apif})"; else echo "not running (configured: ${MODE})"; fi
  printf 'ap     %-6s: ' "$apif"; iw dev "$apif" info 2>/dev/null | awk '/type|channel/{printf "%s ",$0} END{print ""}' || true
  printf 'hostapd      : '; if is_running; then echo running; else echo stopped; fi
  printf 'dnsmasq      : '; if { [ -f "$DPID" ] && kill -0 "$(cat "$DPID")" 2>/dev/null; } || pgrep -f "dnsmasq.*--interface=${apif}" >/dev/null 2>&1; then echo running; else echo stopped; fi
  printf 'nat          : '; if iptables -t nat -S POSTROUTING 2>/dev/null | grep -q -- "-o ${CLIENT} -j MASQUERADE"; then echo present; elif [ "$(id -u)" -ne 0 ]; then echo "? (need root)"; else echo absent; fi
}

cmd_detect(){
  local phy; phy=$(client_phy)
  [ -n "$phy" ] || die "no Wi-Fi interface '${CLIENT}' found (set CLIENT= in /etc/wifi-hotspot.conf)"
  iw phy "$phy" info >/dev/null 2>&1 || die "cannot read 'iw phy ${phy} info'"
  probe_caps
  local freq ssid driver apsta p2pgo p2pinfo ranges verdict pst
  freq=$(client_freq || true)
  ssid=$(iw dev "$CLIENT" link 2>/dev/null | awk '/SSID:/{sub(/^[ \t]*SSID: /,"");print;exit}' || true)
  driver=$(basename "$(readlink -f "/sys/class/net/${CLIENT}/device/driver" 2>/dev/null || true)" 2>/dev/null || true)
  ranges=$(host_ranges)

  if [ "$CAP_APSTA" = 0 ]; then apsta="no"
  elif [ "$CAP_APSTA_CH" -le 1 ]; then apsta="yes - same channel only"
  else apsta="yes - up to ${CAP_APSTA_CH} channels"; fi
  if [ "$CAP_P2PGO" = 0 ]; then
    p2pgo="no - $(p2p_reason no-cap)"
    p2pinfo="unused - the client's channel is shared instead"
  elif ! command -v wpa_cli >/dev/null 2>&1; then
    p2pgo="no - $(p2p_reason no-wpa-cli)"
    p2pinfo="$(p2p_reason no-wpa-cli)"
  elif p2p_set_iface; then    # sets P2P_IFACE, so it must not run in a subshell
    p2pgo="yes - group owner may use its own channel"
    case "$P2P_IFACE" in
      "$P2P_DEV") p2pinfo="${WPA_CTRL_DIR}/${P2P_IFACE} (dedicated P2P device)" ;;
      *)          p2pinfo="${WPA_CTRL_DIR}/${P2P_IFACE} (P2P on the client interface)" ;;
    esac
  else
    pst="$P2P_LAST"
    case "$pst" in
      noperm)
        p2pgo="group owner possible; run as root to confirm"
        p2pinfo="${WPA_CTRL_DIR}/${P2P_DEV} or ${CLIENT} (needs root to confirm)" ;;
      *)
        p2pgo="no - $(p2p_reason "$pst")"
        p2pinfo="$(p2p_reason "$pst")" ;;
    esac
  fi

  printf '\n  wifi-hotspot detect\n\n'
  printf '  %-14s: %s (%s)%s\n' "interface" "$CLIENT" "$phy" "${driver:+  [$driver]}"
  if [ -n "${freq:-}" ]; then
    printf '  %-14s: connected to "%s" on channel %s\n' "client link" "${ssid:-?}" "$(chan_label "$freq")"
  else
    printf '  %-14s: not connected\n' "client link"
  fi
  printf '  %-14s: %s\n' "AP + client" "$apsta"
  printf '  %-14s: %s\n' "Wi-Fi Direct" "$p2pgo"
  printf '  %-14s: %s\n' "host channels" "${ranges:-unknown}"

  if [ -n "${freq:-}" ]; then
    chan_band "$freq"
    if can_host_freq "$freq"; then CAN_HOST=1; else CAN_HOST=0; fi
    if [ "$CAN_HOST" != 1 ]; then
      printf '  %-14s: %s - cannot host an AP\n' "this channel" "$(chan_label "$freq")"
    elif [ "$HAVE_DFS" = 1 ]; then
      printf '  %-14s: %s - can host an AP, after a radar check\n' "this channel" "$(chan_label "$freq")"
    else
      printf '  %-14s: %s - can host an AP\n' "this channel" "$(chan_label "$freq")"
    fi
    choose_mode
    # The channel a Wi-Fi Direct group would get, so MODE=p2p is not opaque.
    if [ "$CAP_P2PGO" = 1 ]; then
      gf=$(p2p_freq 2>/dev/null || true)
      if [ -n "${gf:-}" ]; then
        printf '  %-14s: %s - channel the Wi-Fi Direct group would get\n' \
          "group channel" "$(chan_label "$gf")"
      fi
    fi
  fi

  printf '\n'
  printf '  %-14s: %s\n' "hostapd" "$(command -v hostapd || echo 'not installed')"
  printf '  %-14s: %s\n' "dnsmasq" "$(command -v dnsmasq || echo 'not installed')"
  printf '  %-14s: %s\n' "wpa_supplicant" "$p2pinfo"

  printf '\n'
  if [ -z "${freq:-}" ]; then
    verdict='connect to Wi-Fi first; the mode is chosen when the hotspot starts'
  elif [ "$CAP_APSTA" = 0 ]; then
    verdict='this card cannot run an access point while connected to Wi-Fi'
  elif [ "$CAN_HOST" = 1 ] && [ "$HAVE_DFS" = 0 ]; then
    if [ "$MODE_CHOSEN" = same ]; then
      verdict="ready - 'wifi-hotspot up' shares this connection on $(chan_label "$freq")"
    else
      verdict="ready - the hotspot will use a Wi-Fi Direct group on $(chan_label "${P2P_FREQ:-$freq}")"
    fi
  elif [ "$MODE_CHOSEN" = p2p ]; then
    verdict="Wi-Fi Direct: the group gets channel $(chan_label "${P2P_FREQ:-$freq}") of its own while the radio stays on $(chan_label "$freq")"
  elif [ "$CAN_HOST" = 1 ]; then
    verdict="ready - DFS channel $(freq_chan "$freq") needs a radar check first (up to a minute)"
  else
    verdict="cannot host on $(chan_label "$freq") and Wi-Fi Direct is unavailable"
  fi
  printf '  %-14s: %s\n\n' "verdict" "$verdict"
}

wifi_qr_escape(){  # escape special chars for the WIFI: URI (ZXing spec)
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/;/\\;/g; s/,/\\,/g; s/:/\\:/g; s/"/\\"/g'
}

cmd_qr(){
  # Print (and optionally save) a scannable QR code for the hotspot's SSID/PSK.
  # Usage: wifi-hotspot qr [output.png]
  local out="${1:-}" psk wifi ssid_e psk_e
  require_ssid
  psk=$(get_psk)
  [ -n "$psk" ] || die "no PSK found (check $PSKFILE)"
  if ! is_running; then
    echo "note: the hotspot does not appear to be running right now" >&2
  fi
  ssid_e=$(wifi_qr_escape "$SSID")
  psk_e=$(wifi_qr_escape "$psk")
  # Reflect what is actually running, not just the configured preference:
  # Wi-Fi Direct mode is always WPA2 regardless of SECURITY.
  local sec="${SECURITY:-wpa2}"
  # Wi-Fi Direct mode is always WPA2 regardless of SECURITY; read the mode from
  # the state file without requiring hostapd to be running (p2p never starts it).
  if [ "$(state_get MODE 2>/dev/null || true)" = "p2p" ]; then sec="wpa2"; fi
  wifi="WIFI:T:WPA;S:${ssid_e};P:${psk_e};H:false;;"
  # Record the resolved mode for the label below.
  SECURITY_RESOLVED="$sec"
  if ! command -v qrencode >/dev/null 2>&1; then
    echo "qrencode is not installed (install 'qrencode' to render a QR code)."
    echo "WiFi string: $wifi"
    return 0
  fi
  printf 'SSID:     %s\n' "$SSID"
  printf 'Password: %s\n' "$psk"
  case "${SECURITY_RESOLVED:-wpa2}" in
    wpa3)   printf 'Security: WPA3 (SAE)\n' ;;
    mixed)  printf 'Security: WPA2+WPA3 (transition)\n' ;;
    *)      printf 'Security: WPA2 (WPA-PSK)\n' ;;
  esac
  if [ -n "$out" ]; then
    qrencode -o "$out" -s 8 -m 2 "$wifi" && printf 'saved: %s\n' "$out"
  fi
  printf '\n=== scan with your phone camera ===\n'
  qrencode -t UTF8 "$wifi"
}

usage(){
  printf 'Usage: wifi-hotspot {up|down|restart|sync|status|detect|qr}\n' >&2
  printf '       wifi-hotspot --version\n' >&2
  printf '       wifi-hotspot up [--mode auto|same|p2p]\n' >&2
  printf '       wifi-hotspot qr [output.png]\n' >&2
}
parse_args(){ # skip the command word; accept --mode
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --mode)   [ $# -ge 2 ] || die "--mode needs a value (auto, same or p2p)"; MODE="$2"; shift 2 ;;
      --mode=*) MODE="${1#*=}"; shift ;;
      *)        die "unknown option: $1" ;;
    esac
  done
  case "$MODE" in auto|same|p2p) ;; *) die "MODE must be auto, same or p2p (got '$MODE')" ;; esac
}

if [ "${WIFI_HOTSPOT_TEST_MODE:-}" != "1" ]; then
  cmd="${1:-status}"
  case "$cmd" in up|restart|sync) parse_args "$@" ;; esac  # reject bad options before elevating
  case "$cmd" in up|down|restart|sync|qr) as_root "$@" ;; esac
  case "$cmd" in up|down|restart|sync) lock_acquire ;; esac
  case "$cmd" in
    up)      cmd_up ;;
    down)    cmd_down ;;
    restart) cmd_down; cmd_up ;;
    sync)    cmd_sync ;;
    status)  cmd_status ;;
    detect)  cmd_detect ;;
    qr)      cmd_qr "${2:-}" ;;
    --version|-V|version) echo "wifi-hotspot $VERSION"; exit 0 ;;
    -h|--help|help) usage; exit 0 ;;
    *)       usage; exit 1 ;;
  esac
fi

# Test-mode notice: when WIFI_HOTSPOT_TEST_MODE=1 the dispatch above is
# skipped, so an invocation does nothing.  Make that visible on stderr so an
# accidental no-op is not mistaken for success.
if [ "${WIFI_HOTSPOT_TEST_MODE:-}" = "1" ]; then
  printf '[wifi-hotspot] test mode: no action taken\n' >&2
fi
